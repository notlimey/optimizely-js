{
  "name": "@notlimey/optimizely-nextjs-multisite",
  "version": "0.0.1-alpha.1",
  "description": "A next.js package to support optimizely multisite",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./debug/*": {
      "import": "./dist/debug/*.js",
      "types": "./dist/debug/*.d.ts"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": "16"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
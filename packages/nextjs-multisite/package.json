{
  "name": "@notlimey/optimizely-nextjs-multisite",
  "version": "0.0.3",
  "description": "A next.js package to support optimizely multisite",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsup src/index.ts --format cjs,esm --dts && esbuild dist/**/*.js --minify --outdir=dist/min && esbuild dist/**/*.cjs --minify --outdir=dist/min --out-extension:.js=.cjs",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "files": [
    "dist/min/*",
    "dist/index.d.ts",
    "dist/index.d.cts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/min/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/min/index.cjs"
      }
    }
  },
  "keywords": [],
  "author": "notlimey",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/notlimey/optimizely-js.git",
    "directory": "packages/nextjs-multisite"
  },
  "bugs": {
    "url": "https://github.com/notlimey/optimizely-js/issues"
  },
  "homepage": "https://github.com/notlimey/optimizely-js/tree/main/packages/nextjs-multisite#readme",
  "devDependencies": {
    "esbuild": "^0.27.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": "16"
  }
}